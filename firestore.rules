rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin' || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')) ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'superadmin' || 
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'SUPER_ADMIN'))
      );
    }

    function isGroupAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'groupadmin' || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'GROUP_ADMIN')) ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'groupadmin' || 
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'GROUP_ADMIN'))
      );
    }

    // Rule 6: platformRevenue/main can only be updated via increment, never setDoc overwrite
    match /platformRevenue/{docId} {
      allow read: if true;
      // Disallow client setDoc creating or overwriting platformRevenue/main
      allow create: if false;
      allow delete: if false;

      // Only allow updating existing main document via additive increments:
      // Gross earnings and stream amounts can never decrease (preventing setDoc overwrite or balance wipe)
      allow update: if docId == 'main'
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'stream1', 'stream2', 'stream3', 'stream4',
          'totalGross', 'totalWithdrawn', 'unifiedAvailable', 'lastUpdated'
        ])
        && request.resource.data.totalGross >= resource.data.totalGross
        && request.resource.data.totalWithdrawn >= resource.data.totalWithdrawn
        && request.resource.data.stream1 >= resource.data.stream1
        && request.resource.data.stream2 >= resource.data.stream2
        && request.resource.data.stream3 >= resource.data.stream3
        && request.resource.data.stream4 >= resource.data.stream4;
    }

    // Personal Ajo - STRICT SECURITY & ROLE VISIBILITY
    // personal_ajo must ONLY be visible to role=user and only his own doc.
    match /personal_ajo/{docId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.user_id && isSuperAdmin() == false && isGroupAdmin() == false;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id && isSuperAdmin() == false && isGroupAdmin() == false;
      allow delete: if false;
    }

    // Users and Profiles
    match /users/{userId} {
      allow read, write: if true;
    }
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    // Group & Savings Collections
    match /groups/{groupId} {
      allow read, write: if true;
    }
    match /group_members/{memberId} {
      allow read, write: if true;
    }
    match /contributions/{contribId} {
      allow read, write: if true;
    }
    match /transactions/{txId} {
      allow read, write: if true;
    }
    match /payments/{paymentId} {
      allow read, write: if true;
    }
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
