rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin' || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')) ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'superadmin' || 
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'SUPER_ADMIN'))
      );
    }

    function isGroupAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'groupadmin' || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'GROUP_ADMIN')) ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'groupadmin' || 
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'GROUP_ADMIN'))
      );
    }

    // platformRevenue
    match /platformRevenue/{docId} {
      allow read, write, delete: if true;
    }

    // Platform Stats: Aggregate metrics for superadmin (totalPersonalSavings)
    match /platformStats/{docId} {
      allow read, write, delete: if true;
    }

    // Personal Ajo - Real transactions atomic access
    match /personalAjos/{docId} {
      allow read, write: if true;
    }
    match /personal_ajo/{docId} {
      allow read, write: if true;
    }

    // Users and Profiles
    match /users/{userId} {
      allow read, write: if true;
    }
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    // Group & Savings Collections
    match /groups/{groupId} {
      allow read, write: if true;
    }
    match /group_members/{memberId} {
      allow read, write: if true;
    }
    match /contributions/{contribId} {
      allow read, write: if true;
    }
    match /transactions/{txId} {
      allow read, write: if true;
    }
    match /pack_transactions/{docId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == request.resource.data.user_id && request.resource.data.amount == 600 && request.resource.data.status == 'success') || true;
    }
    match /commissions/{docId} {
      allow read, write: if true;
    }
    match /payments/{paymentId} {
      // Reject any packing commission wrongly targeted at the payments/registration collection
      allow read: if true;
      allow write: if (!('type' in request.resource.data) || request.resource.data.type != 'packing_commission')
        && (!('stream' in request.resource.data) || request.resource.data.stream != 'packing_commission');
    }
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
