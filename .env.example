# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Optional Paystack Secret Key for live/test Paystack API
PAYSTACK_SECRET_KEY=""
# PAYSTACK_PUBLIC_KEY: Optional Paystack Public Key
PAYSTACK_PUBLIC_KEY=""

# SUPABASE_URL: Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY: Supabase secret service role key for backend server database operations
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_ANON_KEY: Supabase public anonymous key
SUPABASE_ANON_KEY=""
# VITE_SUPABASE_URL: Client-exposed Supabase Project URL
VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY: Client-exposed Supabase anon key
VITE_SUPABASE_ANON_KEY=""

# FIREBASE_PROJECT_ID: Firebase project ID (e.g., better-ajo-prod)
FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL: Firebase Admin service account client email
FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY: Firebase Admin service account private key (in PEM format with \n or escaped newlines)
FIREBASE_PRIVATE_KEY=""
